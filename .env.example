# ==============================================================================
# PRECURSOR Environment Configuration
# Copy this file to `.env` in the project root:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Copilot (Groq Cloud API - Recommended)
# Get your API key from Groq Console: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=
# Default model: llama-3.3-70b-versatile (also supports llama-3.1-8b-instant, qwen/qwen-2.5-32b)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. AI Copilot (Gemini API - Optional Fallback)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Alternative key name supported:
# GOOGLE_API_KEY=
# Default model: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. Local LLM / Ollama Fallback (Optional)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. Backend REST Server
# ------------------------------------------------------------------------------
PRECURSOR_HOST=0.0.0.0
PRECURSOR_PORT=8000

# ------------------------------------------------------------------------------
# 4. Frontend / Vite UI Client
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
VITE_APP_ENV=development
